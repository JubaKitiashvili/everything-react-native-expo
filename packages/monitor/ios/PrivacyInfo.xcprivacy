<?xml version="1.0" encoding="UTF-8"?>
<!--
  @erne/monitor — Apple Privacy Manifest

  This file declares what the SDK collects, how it uses required-reason
  APIs, and whether it tracks users. Apple's App Store review validates
  this against the SDK's actual runtime behavior, so the entries here
  must match what the code does. Keep synced with ios/NativeMetrics.swift
  (disk space + thermal), CrashHandler.swift (file timestamps on crash
  reports), and SpanLog.swift (file timestamps on span log rotation).

  References:
    https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
    https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_data_use_in_privacy_manifests
    https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The SDK does not track users across apps and websites owned by
         other companies. No IDFA access, no ad attribution, no cross-app
         linking. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Data the SDK collects. All marked not-linked-to-identity and
         not-used-for-tracking. Purpose is always App Functionality
         (crash reporting + performance diagnostics). -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePerformanceData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!-- Required-reason APIs the SDK calls. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- NativeMetrics.swift reads NSURL disk capacity via
             URLResourceKey.volumeAvailableCapacityKey / totalCapacityKey.
             Reason 85F4.1: "Declare this reason to display disk space
             information to the user." Applies here because the dashboard
             surfaces disk availability to the developer. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>85F4.1</string>
            </array>
        </dict>

        <!-- CrashReportWriter.swift and SpanLog.swift read/write files
             with timestamps (FileManager + NSURL creationDate keys) to
             persist crash reports + span logs across process death.
             Reason C617.1: "Declare this reason to access the timestamps
             of files inside the app container." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
